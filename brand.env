# Stoatium branding and instance configuration.
#
# Every value here is injected at build time. Change these, rebuild, and you
# have your own client — no patch edits required.
#
# Lines are KEY=VALUE. No quotes, no shell expansion, # starts a comment.

# ---------------------------------------------------------------------------
# Instance
# ---------------------------------------------------------------------------

# Default instance the client connects to. This is the one value that makes
# the build "yours". Point it at the /app path of your for-web deployment.
#
# Users can still override it at runtime:
#   stoatium.exe --force-server=https://chat.example.com/app
# which is then persisted, so it is only needed once.
STOATIUM_SERVER_URL=https://chat.example.com/app

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

STOATIUM_PRODUCT_NAME=Stoatium
STOATIUM_EXEC_NAME=stoatium
STOATIUM_APP_ID=chat.stoatium.Stoatium
STOATIUM_AUTHOR=Stoatium Contributors
STOATIUM_DESCRIPTION=Debranded, self-host-configurable chat client.
STOATIUM_COPYRIGHT=AGPL-3.0-or-later

# Windows AppX signing identity. Only used by the appx maker, which is
# skipped in CI.
STOATIUM_APPX_PUBLISHER=CN=Stoatium

# ---------------------------------------------------------------------------
# Optional integrations — all disabled when left empty
# ---------------------------------------------------------------------------

# Discord Rich Presence. Upstream ships its own application ID, which would
# present your build to Discord as "Stoat". Register your own at
# https://discord.com/developers/applications, or leave empty to keep Rich
# Presence off entirely.
STOATIUM_DISCORD_APP_ID=

# Auto-update source, as "owner/name". Requires a public GitHub repo
# publishing releases via update.electronjs.org. Leave empty to disable —
# do NOT point this at an upstream repo, or your users will be updated onto
# someone else's build.
STOATIUM_UPDATE_REPO=

# Release target for `pnpm publish`, as "owner/name". Leave empty to build
# local artifacts only.
STOATIUM_PUBLISH_REPO=
