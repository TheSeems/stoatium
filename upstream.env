# Pinned upstream revisions.
#
# Bump a tag, run `scripts/prepare.sh --force`, and fix any rejects. Keeping
# this pinned is the whole point: an unpinned clone means patches break at
# random rather than when you choose to look at them.

DESKTOP_REPO=https://github.com/stoatchat/for-desktop.git
DESKTOP_TAG=v1.4.2

# The web client needs no patches to be *configurable* — upstream already does
# runtime env injection. It is patched only to complete the Russian catalog.
#
# Pinned to the commit upstream's self-hosted compose ships alongside api
# v0.13.8, NOT to the newest release: for-web v0.14.1 exists but is four minor
# versions ahead of the API deployed here, and that pairing is untested. Bump
# both together or not at all.
WEB_REPO=https://github.com/stoatchat/for-web.git
WEB_TAG=746bee5821e5474cbcdeea414d04ead87b85fe43
