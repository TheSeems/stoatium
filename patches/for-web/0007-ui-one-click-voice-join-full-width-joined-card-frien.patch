+/**
+ * Dates sit side by side across the full-width card rather than stacked, so
+ * the card fills its row instead of leaving a long empty tail.
+ */
+const Entries = styled("div", {
+  base: {
+    display: "flex",
+    flexWrap: "wrap",
+    gap: "var(--gap-lg)",
+    marginBlockStart: "var(--gap-sm)",
+  },
+});
+
+const Entry = styled("div", {
+  base: {
+    minWidth: 0,
+    flex: "1 1 140px",
+    display: "flex",
+    flexDirection: "column",
+    gap: "2px",
+  },
+});
