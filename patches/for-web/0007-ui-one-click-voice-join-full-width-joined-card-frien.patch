@@ -494,6 +494,18 @@ function Entry(
     <Column gap="sm">
       <MenuButton
         href={`/server/${props.channel.serverId}/channel/${props.channel.id}`}
+        onClick={() => {
+          // Joining a voice channel used to take two clicks: one here to open
+          // the channel, then another on the call card's "Join the voice
+          // channel" preview. Connect on the same click that navigates.
+          //
+          // Guarded on inCall(): connect() begins by calling disconnect(), so
+          // clicking the channel you are already in would drop the call and
+          // immediately rejoin it.
+          if (props.channel.isVoice && !inCall()) {
+            voice.connect(props.channel);
+          }
+        }}
         use:floating={props.menuGenerator(props.channel)}
         size="normal"
         alert={alertState()}
