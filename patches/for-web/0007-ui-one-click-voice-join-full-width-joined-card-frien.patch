 export function ProfileJoined(props: { user: User; member?: ServerMember }) {
   const dayjs = useTime();
 
+  /**
+   * dayjs' L format is locale-dependent and Russian's is DD.MM.YYYY. Swapping
+   * MM for MMM gives an abbreviated month name; every separator then has to
+   * go, not just / and -, because leaving the dots in produced "02.авг..2026"
+   * -- the separator dot, then the one the ru locale puts on the abbreviated
+   * month itself.
+   */
+  const format = (date: Date) =>
+    dayjs(date).format(
+      timeLocale()[1].formats.L?.replace("MM", "MMM").replaceAll(/[/.-]/g, " "),
+    );
+
   return (
-    <ProfileCard>
-      {/*
-        Not <Text size="large">: this card is a 1/1 tile with overflow hidden,
-        sized around the English "Joined". Russian's "Присоединился" is a
-        single 13-character word, so at that size it overflowed the tile and
-        was clipped mid-word. Wrapping and a slightly smaller size keep it
-        inside without touching the shared Text component.
-      */}
+    // width=3 spans the profile modal's three-column grid.
+    //
+    // At the default width=1 this is a square tile with overflow hidden, about
+    // 165px wide, which is narrower than the Russian heading
+    // "Присоединившиеся" -- so the title broke mid-word. And because a user
+    // with no roles, status, badges or mutuals renders nothing beside it, the
+    // lone tile stranded itself in the left column of an otherwise empty grid.
+    // Spanning the row fixes both: the heading fits on one line, and the card
+    // fills the modal instead of hugging one corner.
+    <ProfileCard width={3}>
       <CardTitle>
         <Trans>Joined</Trans>
       </CardTitle>
-      <Text class="label">
-        <OverflowingText>Stoat</OverflowingText>
-        {/* <Trans>Account Created</Trans> */}
-      </Text>
-      <Text>
-        {dayjs(props.user.createdAt).format(
-          timeLocale()[1]
-            .formats.L?.replace("MM", "MMM")
-            .replaceAll(/[/.-]/g, " "),
-        )}
-      </Text>
-      <Show when={props.member}>
-        <Text class="label">
-          <OverflowingText>{props.member!.server!.name}</OverflowingText>
-          {/* <Trans>Member Since</Trans> */}
-        </Text>
-        <Text>
-          {dayjs(props.member!.joinedAt).format(
-            timeLocale()[1]
-              .formats.L?.replace("MM", "MMM")
-              // Every separator, not just / and -. Russian's L format is
-              // DD.MM.YYYY, so leaving "." in place produced "02.авг..2026":
-              // the separator dot, then the one dayjs's ru locale puts on the
-              // abbreviated month itself.
-              .replaceAll(/[/.-]/g, " "),
-          )}
-        </Text>
-      </Show>
+      <Entries>
+        <Entry>
+          <Text class="label">
+            {/*
+              Was a hardcoded "Stoat". This is a debranded build, and the label
+              is describing when the account was made, not which product made
+              it.
+            */}
+            <Trans>Account created</Trans>
+          </Text>
+          <Text>{format(props.user.createdAt)}</Text>
+        </Entry>
+        <Show when={props.member}>
+          <Entry>
+            <Text class="label">
+              <OverflowingText>{props.member!.server!.name}</OverflowingText>
+            </Text>
+            <Text>{format(props.member!.joinedAt)}</Text>
+          </Entry>
+        </Show>
+      </Entries>
     </ProfileCard>
   );
 }
 
 /**
- * Heading for the joined-date tile.
- *
- * Sized to survive a long single-word translation inside a fixed-aspect tile.
+ * Heading for the joined-date card.
  */
 const CardTitle = styled("div", {
   base: {
     fontWeight: 600,
-    fontSize: "0.95rem",
+    fontSize: "1rem",
     lineHeight: 1.2,
-    whiteSpace: "normal",
-    overflowWrap: "anywhere",
     color: "var(--md-sys-color-on-surface)",
   },
 });
