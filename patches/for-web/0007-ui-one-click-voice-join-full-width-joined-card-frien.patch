+/**
+ * Column holding the tab row above the scrolling list.
+ *
+ * min-height 0 so the list, not this element, is what scrolls -- a flex child
+ * defaults to min-height:auto and would otherwise refuse to shrink, pushing
+ * the overflow up and breaking the virtual list's scroll target.
+ */
+const Content = styled("div", {
+  base: {
+    flex: 1,
+    minHeight: 0,
+    display: "flex",
+    flexDirection: "column",
+  },
+});
+
+/**
+ * Tab row plus the add-friend action.
+ */
+const Toolbar = styled("div", {
+  base: {
+    display: "flex",
+    flexWrap: "wrap",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: "var(--gap-md)",
+
+    maxWidth: "960px",
+    width: "100%",
+    marginInline: "auto",
+    paddingInline: "var(--gap-x)",
+    paddingBlock: "var(--gap-l)",
+  },
+});
+
+const Tabs = styled("div", {
+  base: {
+    display: "flex",
+    flexWrap: "wrap",
+    gap: "var(--gap-sm)",
+    padding: "4px",
+    borderRadius: "var(--borderRadius-full)",
+    background: "var(--md-sys-color-surface-container-low)",
+  },
+});
+
+/**
+ * Pending-request count shown inside its tab.
+ */
+const Count = styled("span", {
+  base: {
+    minWidth: "20px",
+    paddingInline: "6px",
+    borderRadius: "var(--borderRadius-full)",
+
+    fontSize: "0.75rem",
+    fontWeight: 600,
+    lineHeight: "20px",
+    textAlign: "center",
+
+    background: "var(--md-sys-color-error)",
+    color: "var(--md-sys-color-on-error)",
+  },
+});
+
+const Tab = styled("button", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    gap: "var(--gap-sm)",
+    whiteSpace: "nowrap",
+
+    border: "none",
+    cursor: "pointer",
+    font: "inherit",
+    fontWeight: 500,
+    paddingInline: "var(--gap-lg)",
+    paddingBlock: "var(--gap-md)",
+    borderRadius: "var(--borderRadius-full)",
+
+    background: "transparent",
+    color: "var(--md-sys-color-on-surface-variant)",
+    transition: "background .15s, color .15s",
+
+    "&:hover": {
+      background: "var(--md-sys-color-surface-container-high)",
+      color: "var(--md-sys-color-on-surface)",
+    },
+  },
+  variants: {
+    active: {
+      true: {
+        // Paired tokens: on-secondary-container is defined as the readable
+        // foreground for secondary-container. Picking the background alone
+        // and leaving the inherited colour is what made earlier selected
+        // states wash out.
+        background: "var(--md-sys-color-secondary-container)",
+        color: "var(--md-sys-color-on-secondary-container)",
+
+        "&:hover": {
+          background: "var(--md-sys-color-secondary-container)",
+          color: "var(--md-sys-color-on-secondary-container)",
+        },
+      },
+    },
+  },
+});
+
 /**
  * List of users
  */
diff --git a/packages/client/src/interface/navigation/channels/ServerSidebar.tsx b/packages/client/src/interface/navigation/channels/ServerSidebar.tsx
