From 3af3069de2c49455726446bbff03a3f2ce2db04f Mon Sep 17 00:00:00 2001
From: Stoatium Build <stoatium@localhost>
Date: Sun, 2 Aug 2026 14:36:57 +0300
Subject: i18n(ru): plural forms, remaining literals, and long-word clipping
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

"1 участников в сети" was wrong: Russian has four plural categories and a
single form is only correct for the "many" case. The translation is now an
ICU plural, which lingui accepts even though the source message is not
itself plural.

Three more bare literals: the message search placeholder, and the synthesised
Online/Offline member-group names -- those are built as role objects rather
than rendered as text, which is why they were easy to miss.

The joined-date tile is a 1/1 tile with overflow hidden, sized around the
English "Joined". Russian's "Присоединился" is one 13-character word and was
clipped mid-word, so that heading now wraps at a slightly smaller size
instead of using the shared large Text style.
---
 .../components/i18n/catalogs/ru/messages.po   |  5 +++-
 .../features/profiles/ProfileJoined.tsx       | 29 +++++++++++++++++--
 .../src/interface/channels/ChannelHeader.tsx  |  2 +-
 .../interface/channels/text/MemberSidebar.tsx |  5 ++--
 4 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/packages/client/components/i18n/catalogs/ru/messages.po b/packages/client/components/i18n/catalogs/ru/messages.po
index ac08871d..4cfae80b 100644
--- a/packages/client/components/i18n/catalogs/ru/messages.po
+++ b/packages/client/components/i18n/catalogs/ru/messages.po
@@ -3622,10 +3622,13 @@ msgid "Direct Messages"
 msgstr "Личные сообщения"
 
 msgid "{0} members online"
-msgstr "{0} участников в сети"
+msgstr "{0, plural, one {# участник в сети} few {# участника в сети} many {# участников в сети} other {# участника в сети}}"
 
 msgid "Incoming"
 msgstr "Входящие"
 
 msgid "Outgoing"
 msgstr "Исходящие"
+
+msgid "Search messages..."
+msgstr "Поиск сообщений…"
