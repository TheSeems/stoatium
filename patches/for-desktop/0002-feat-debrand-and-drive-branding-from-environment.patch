-        buttons: [
-          {
-            label: "Join Stoat",
-            url: "https://stoat.chat/",
-          },
-        ],
+        largeImageText: STOATIUM_PRODUCT_NAME,
       }),
     );
 
     rpc.on("disconnected", reconnect);
 
-    rpc.login({ clientId: "872068124005007420" });
+    rpc.login({ clientId: STOATIUM_DISCORD_APP_ID });
   } catch (err) {
     reconnect();
   }
