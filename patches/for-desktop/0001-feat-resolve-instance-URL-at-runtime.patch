diff --git a/src/native/window.ts b/src/native/window.ts
index d183972..056c658 100644
--- a/src/native/window.ts
+++ b/src/native/window.ts
@@ -20,11 +20,35 @@ import { updateTrayMenu } from "./tray";
 export let mainWindow: BrowserWindow;
 
 // currently in-use build
-export const BUILD_URL = new URL(
-  app.commandLine.hasSwitch("force-server")
-    ? app.commandLine.getSwitchValue("force-server")
-    : /*MAIN_WINDOW_VITE_DEV_SERVER_URL ??*/ "https://stoat.chat/app",
-);
+//
+// Resolved lazily, NOT at module scope: `config` imports `mainWindow` from
+// this module, so touching `config` during this module's evaluation hits the
+// temporal dead zone on `export const config` and throws.
+let buildUrl: URL | undefined;
+
+/**
+ * Resolve the instance to connect to.
+ *
+ * Order of precedence:
+ *   1. `--force-server=<url>` — persisted, so it is only needed once
+ *   2. previously stored `serverUrl`
+ *   3. `STOATIUM_SERVER_URL` — baked in at build time from brand.env
+ */
+export function getBuildUrl(): URL {
+  if (buildUrl) return buildUrl;
+
+  let target: string;
+
+  if (app.commandLine.hasSwitch("force-server")) {
+    target = app.commandLine.getSwitchValue("force-server");
+    config.serverUrl = target;
+  } else {
+    target = config.serverUrl || STOATIUM_SERVER_URL;
+  }
+
+  buildUrl = new URL(target);
+  return buildUrl;
+}
 
 // internal window state
 let shouldQuit = false;
@@ -89,7 +113,7 @@ export function createMainWindow() {
   }
 
   // load the entrypoint
-  mainWindow.loadURL(BUILD_URL.toString());
+  mainWindow.loadURL(getBuildUrl().toString());
 
   // minimise window to tray
   mainWindow.on("close", (event) => {
